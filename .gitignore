# ============================================================
# Workspace (the sandbox the agent acts in)
# ============================================================
# If someone points --workspace inside the repo, don't commit
# what the agent created there.
workspace/
machia-workspace/

# But keep an empty placeholder so the folder structure is
# visible in a fresh clone.
!workspace/.gitkeep
!machia-workspace/.gitkeep

